# ==============================================================================
# OPPO A57 (16061, MSM8940 / PMI8950) —— 4.19 配置片段
# ------------------------------------------------------------------------------
# 用法：
#   make O=out ARCH=arm64 vendor/msm8953-perf_defconfig vendor/mi8953.config \
#        vendor/oppo-common.config vendor/oppo-a57.config \
#        vendor/oppo-bpf-containers.config
#
# ⚠ A57 与 R9s 必须**分别构建**，不能塞进同一个内核：
#   两者触摸屏驱动（Goodix GT5688 vs Synaptics S3320）各自导出同名全局符号
#       is_gesture_enable_for_lcd
#       lcd_wakeup_finger_protect
#       touchkey_enabled
#   同时编会触发链接错误 multiple definition。
#   （4.9 分支本来就是 A57 / R9s 两份 defconfig 分开编译的。）
#
# ⚠ merge_config.sh 的解析正则是
#     ^\(# \)\{0,1\}\(CONFIG_[A-Za-z0-9_]*\)[= ]
#   命中后 sed -i "/$CFG[ =]/d" 会删掉同名符号。
#   所以本文件不能出现形如 "# CONFIG_XXX is not set" 的**说明性**注释。
# ==============================================================================

# ---- SoC ---------------------------------------------------------------------
# MSM8940 与 MSM8937 是同一颗芯片的不同 SKU，4.19 基线没有独立的
# ARCH_MSM8940 符号也不需要：4.9 里 PINCTRL_MSM8940 甚至是个悬空符号
# （Kconfig 有定义但 Makefile 从未引用），实际一直用 pinctrl-msm8937.o。
# 注意：ARCH_MSM8937 在本仓库已被改回 select COMMON_CLK_MSM（老时钟框架），
# 与 R9s 的 ARCH_MSM8953 保持一致，详见 arch/arm64/Kconfig.platforms 的注释。
CONFIG_ARCH_MSM8937=y

# ---- OPPO 机型 ----------------------------------------------------------------
CONFIG_MACH_OPPO_MSM8937=y
CONFIG_MACH_16061=y

# ---- 触摸屏 —— A57 是 Goodix GT5688（R9s 是 Synaptics，二者互斥）-------------
CONFIG_TOUCHPANEL_OPPO=y
CONFIG_TOUCHPANEL_GOODIX=y
CONFIG_TOUCHPANEL_GOODIX_GT5688=y

# ---- pinctrl ------------------------------------------------------------------
CONFIG_PINCTRL_MSM8937=y
CONFIG_PINCTRL_MSM8917=y

# ---- 显示屏背光 —— A57 与 R9s 同为 LM3697 -------------------------------------
# LM3697 是 TI LMU MFD 的子设备：必须先使能 MFD_TI_LMU，否则 ti,lm3697 绑不上驱动，
# lm3697_bl 不 probe，/sys/class/backlight/lm3697 不出现 -> 锁屏后写背光失败黑屏。
CONFIG_MFD_TI_LMU=y
CONFIG_BACKLIGHT_LM3697=y

# ---- 音频 ---------------------------------------------------------------------
# A57 用平台内置 codec + TFA9890 外放（没有 R9s 的 AK4376 耳机 DAC）。
CONFIG_SND_SOC_TFA98XX=y
