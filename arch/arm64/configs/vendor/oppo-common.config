# ==============================================================================
# OPPO 通用配置（R9s 与 A57 共用）—— 4.19 配置片段
# ------------------------------------------------------------------------------
# 用法（与机型专属片段一起交给同一次 make 调用）：
#   R9s:  make ... vendor/msm8953-perf_defconfig vendor/mi8953.config \
#               vendor/oppo-common.config vendor/oppo-r9s.config \
#               vendor/oppo-bpf-containers.config
#   A57:  make ... vendor/msm8953-perf_defconfig vendor/mi8953.config \
#               vendor/oppo-common.config vendor/oppo-a57.config \
#               vendor/oppo-bpf-containers.config
#
# 拆成 common + 机型专属 的原因：
#   R9s 与 A57 的触摸屏驱动（Synaptics vs Goodix）各自导出同名全局符号
#   （is_gesture_enable_for_lcd / lcd_wakeup_finger_protect /
#     touchkey_enabled），一个内核里不能同时编两套，否则链接期
#   "multiple definition of ..."。所以两个机型必须分别构建。
#   其余 OPPO 通用能力（squashfs/pstore/背光/NLS 等）抽到这里共用。
#
# ⚠ merge_config.sh 的解析正则是
#     ^\(# \)\{0,1\}\(CONFIG_[A-Za-z0-9_]*\)[= ]
#   命中后 sed -i "/$CFG[ =]/d" 会删掉同名符号。
#   所以本文件不能出现形如 "# CONFIG_XXX is not set" 的**说明性**注释。
# ==============================================================================

# ---- OPPO 通用 ----------------------------------------------------------------
CONFIG_MACH_OPPO=y
CONFIG_OPPO_DEVICE_INFO=y

# ---- 文件系统 —— ROM 的 system/vendor 是 squashfs -----------------------------
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_FRAGMENT_CACHE_SIZE=3
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_INDEX=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# ---- ramoops（真机日志抓取，排障必需）----------------------------------------
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_LZ4_COMPRESS=y

# ---- 显示与背光 ---------------------------------------------------------------
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_LCD_CLASS_DEVICE=y

# ---- 触觉反馈 -----------------------------------------------------------------
CONFIG_INPUT_QTI_HAPTICS=y

# ---- 安全 ---------------------------------------------------------------------
CONFIG_SECURITY_DMESG_RESTRICT=y

# ---- MGLRU（多代 LRU，backport 自 6.1）------------------------------------
# 编译进去但**默认不启用**，保持现有 VM 行为完全不变。
# 真机想试的话：
#     echo 1 > /sys/kernel/mm/lru_gen/enabled     # 启用
#     echo 0 > /sys/kernel/mm/lru_gen/enabled     # 退回原 LRU
# 出问题无需回刷内核。
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_STATS=y

# ---- EROFS（只读镜像，LOS 的 system/vendor 可能用它）----------------------
# 4.19 树自带 fs/erofs，这里显式打开，含 LZ4 压缩与多线程解压。
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_PCPU_KTHREAD=y
