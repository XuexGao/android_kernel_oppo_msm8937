# ==============================================================================
# OPPO R9s (16017 / 16027, MSM8953 / Snapdragon 625) — 4.19 配置片段
# ------------------------------------------------------------------------------
# 用法：make O=out ARCH=arm64 vendor/msm8953-perf_defconfig vendor/mi8953.config \
#            vendor/oppo-16017.config
#   （vendor/mi8953.config 是必需项：qpnp-fg.c 无保护地引用
#     CONFIG_MACH_XIAOMI_MSM8953；本文件不启用任何 Xiaomi 机型）
#
# 内容来源：4.9 分支 arch/arm64/configs/lineageos_R9s_defconfig 相对
#           msm8953-perf_defconfig 的差异，逐条筛掉 4.19 已不存在的符号。
# ==============================================================================

# ---- OPPO 机型选择 ----
CONFIG_MACH_OPPO_MSM8953=y
CONFIG_MACH_16017=y
CONFIG_MACH_16027=y

# ---- 触摸屏（R9s 用 Synaptics S3508 / S3320，I2C）----
CONFIG_SYNAPTICS_OPPO=y

# ---- 电池计 / VOOC 快充 ----

# ---- 输入 / 振动 ----

# ---- 存储 ----

# ---- 调试/日志（pstore 抓早期 log）----

# ---- 背光（16027 真机的屏幕是否能亮，全看这一项）----
# 4.19 基线没有开 BACKLIGHT_CLASS_DEVICE（它 default m，但基线没选），
# 而 BACKLIGHT_LM3697 依赖它 —— 不打开就绑不上 ti,lm3697，直接黑屏。
# 16027 的背光是独立 LM3697 @ i2c_2（见 oppo-msm8953/16027/msm8953-mtp.dtsi）。
CONFIG_BACKLIGHT_LM3697=y
# 基线把 LCD_CLASS_DEVICE 设成了 m，会多出一个用不到的 .ko；本内核不做模块，压成 y。

# ---- 隐藏面：限制 dmesg ----

# ---- 文件系统：SQUASHFS 是能否进系统的关键 ----
#
# 实测日志（ramoops）：
#     request_module fs-squashfs succeeded, but still no fs?
#     reboot: Restarting system with command 'bootloader'
# LineageOS 22.1 的 system/vendor 是 squashfs，而 4.19 基线**没有**开
# SQUASHFS（基线只带 erofs/f2fs/ext4）。init 挂不上 /system 就直接
# 让内核 reboot 到 bootloader —— 表现就是「开机后进 fastboot」。
#
# 参数照抄能正常开机的 lineage-22.1 R9s defconfig。

# ---- 文件系统（其余）----
# 4.19 基线已自带 EROFS/F2FS/EXT4/FUSE/OVERLAY/VFAT/EXFAT/DM_VERITY/DM_CRYPT，
# 与 4.9 工作内核一致，无需重复声明。这里只补 NLS（squashfs/vfat 挂载需要）。

# ---- 音频 codec（AK4376 DAC + TFA98XX Smart PA）----
# 两者都挂在 i2c_8，两个机型的 DTS 都声明了（akm,ak4376 @0x10、nxp,tfa98xx @0x36）。
# 4.19 已彻底移除老 ASoC codec API（struct snd_soc_codec 全树 0 处），
# 这两个驱动已迁移到 snd_soc_component，见 sound/soc/codecs/{ak4376,tfa98xx}.c。
CONFIG_SND_SOC_AK4376=y
CONFIG_SND_SOC_TFA98XX=y

CONFIG_INPUT_FPC1020=y

# ---- 仍未移植（4.19 基线无对应驱动，故不在此声明）----
#   KTD2026 指示灯。
# 按本文件顶部警告，带 CONFIG_ 的说明性注释有误删符号的风险，所以这里只写中文描述。
