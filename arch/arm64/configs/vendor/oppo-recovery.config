# ==============================================================================
# Skyward recovery 专用配置片段 —— OPPO MSM8937 / MSM8953
# ------------------------------------------------------------------------------
# 用法：在 ROM 内核完全相同的基线与机型片段之后追加本片段。
#   R9s: make O=out ARCH=arm64 vendor/msm8953-perf_defconfig \
#            vendor/mi8953.config vendor/oppo-common.config \
#            vendor/oppo-r9s.config vendor/oppo-no-ksu.config \
#            vendor/oppo-recovery.config
#   A57: 同上，把 vendor/oppo-r9s.config 换成 vendor/oppo-a57.config
#
# 为什么单独一份：ROM 内核要跑完整 Android，recovery 只跑 Skyward；
# 但两者共用同一棵 4.19 树、同一套 OPPO 机型片段（显示、触摸、存储、
# 背光都靠它）。本片段只补 recovery 真正需要、而基线没有显式打开的东西：
# gzip initramfs（原厂 recovery 的 ramdisk 就是 gzip）、squashfs（vendor）、
# erofs、FUSE、loop、dm-crypt/dm-verity、keys 与 binder。
#
# ⚠ merge_config.sh 的正则会删掉同名符号，所以本文件不能出现
#   "# CONFIG_XXX is not set" 这种说明性注释。
# ==============================================================================

# ---- initramfs：recovery 的 ramdisk 用 gzip 压缩（与原厂一致）----------------
CONFIG_RD_GZIP=y
CONFIG_RD_LZ4=y

# ---- 只读压缩文件系统：vendor(oem) 是 squashfs，新 ROM 也有 erofs ------------
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_FRAGMENT_CACHE_SIZE=3
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y

# ---- 可读写文件系统：data/cache/metadata 与 U 盘 -----------------------------
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_EXFAT_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# ---- 分区映射 / 加密：刷机脚本写 super；data 解密后续再接 ---------------------
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_VERITY=y
CONFIG_DM_DEFAULT_KEY=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_SHA256=y
CONFIG_KEYS=y
CONFIG_ENCRYPTED_KEYS=y
CONFIG_FUSE_FS=y

# ---- binder：Skyward 要跟手机自己的服务（boot control 等）讲话 ----------------
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# ---- USB：adb、fastbootd 与 MTP ----------------------------------------------
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_UEVENT=y
CONFIG_USB_CONFIGFS_F_FS=y

# ---- 显示 / 输入 / 背光兜底（机型片段里通常已有）-----------------------------
CONFIG_FB=y
CONFIG_FB_MSM=y
CONFIG_FB_MSM_MDSS=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_INPUT_EVDEV=y

# ---- 日志：出问题时 pstore 里能捞到上一轮的内核日志 --------------------------
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_LZ4_COMPRESS=y
