# ==============================================================================
# BakaSU + SUSFS 2.3.x —— 4.19 配置片段
# ------------------------------------------------------------------------------
# 用法（与其他 fragment 一起交给同一次 make 调用）：
#   make O=out ARCH=arm64 vendor/msm8953-perf_defconfig vendor/mi8953.config \
#        vendor/oppo-16017.config vendor/oppo-bpf-containers.config \
#        vendor/oppo-bakasu-susfs.config
#
# 与纯净内核的差别只有这一份：纯净分支用 vendor/oppo-no-ksu.config，
# 本分支用本文件（不加载 oppo-no-ksu.config）。
#
# 注意：本文件里不要出现任何形如 "# CONFIG_XXX is not set" 的**说明性**注释。
#   merge_config.sh 的解析正则是 ^\(# \)\{0,1\}\(CONFIG_[A-Za-z0-9_]*\)[= ]
#   命中后会执行 sed -i "/$CFG[ =]/d" 把同名符号整行删掉。
#   要真正关闭某个符号，必须写成标准的 "# CONFIG_XXX is not set"，
#   而那种行会被当作"设置它为 n"，这也正是本文件里几处关闭语句的用法。
# ==============================================================================

# ---- KernelSU / BakaSU --------------------------------------------------------
CONFIG_KSU=y
CONFIG_KSU_MULTI_MANAGER_SUPPORT=y

# ---- hook 模式：non-GKI 4.9/4.19 只能用 SUSFS inline ---------------------------
# Kconfig 里 KSU_TRACEPOINT_HOOK / KSU_MANUAL_HOOK / KSU_SUSFS 是互斥 choice，
# 而只有 SUSFS inline 模式才保留 SUSFS 的隐藏能力。
# 选错会在 KernelSU 的 Kbuild 里直接 $(error)。
# KSU_SUSFS_ENABLE_LOG 会往 dmesg 打隐藏动作，保持关闭以免暴露。
CONFIG_KSU_SUSFS=y
# CONFIG_KSU_TRACEPOINT_HOOK is not set
# CONFIG_KSU_MANUAL_HOOK is not set
# CONFIG_KSU_SUSFS_ENABLE_LOG is not set

# ---- SUSFS 子功能 -------------------------------------------------------------
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
